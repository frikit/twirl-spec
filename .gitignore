dist/

# Build servers, language servers and their caches
.bsp/
.bloop/
.metals/
metals.sbt
project/metals.sbt
.scala-build/
.ammonite/

# sbt writes coverage, test reports and the runtime pid under target/, but a few
# tools drop them at the root instead.
scoverage-report/
test-output/
RUNNING_PID

# ---------------------------------------------------------------------------
# Other JVM build tools — a Scala repo picks these up as soon as it grows a
# module in another language.
# ---------------------------------------------------------------------------
.gradle/
/build/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.jar
.mvn/timing.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties
dependency-reduced-pom.xml
out/

