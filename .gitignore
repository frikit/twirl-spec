# ---------------------------------------------------------------------------
# VS Code — ignore the folder, but let the team share the four files that are
# genuinely project configuration rather than personal state.
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

