# ---------------------------------------------------------------------------
.classpath
.project
.settings/
.factorypath
.apt_generated/
nbproject/
nbactions.xml
.zed/
.fleet/

# ---------------------------------------------------------------------------
# Editors
# ---------------------------------------------------------------------------
*.swp
*.swo
*~
.netrwhist
\#*\#
.\#*
*.sublime-workspace
*.sublime-project

# ---------------------------------------------------------------------------
# Operating systems
#
# 26 .DS_Store files are committed across this workspace's repositories. It is
# worth being thorough here.
# ---------------------------------------------------------------------------
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*
.nfs*

# ---------------------------------------------------------------------------
# Agentic coding tools
#
# These leave per-developer state in the repository. The pattern below ignores
# the local state while leaving genuinely shared project configuration — agents,
# commands, skills — committable, so a team can check those in deliberately.
# Across this workspace .claude exists in 40 repositories and is tracked in none.
# ---------------------------------------------------------------------------
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/commands/
!.claude/skills/
!.claude/hooks/
CLAUDE.local.md

.cursor/
.cursorignore
.aider*
.continue/
.codeium/
.windsurf/
.gemini/
.opencode/
.crush/
.serena/
.roo/
.kilocode/
.goose/
.specstory/
repomix-output.*
.repomix/

# ---------------------------------------------------------------------------
# Secrets and credentials — nothing here should ever reach a remote.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
.netrc
.npmrc

# ---------------------------------------------------------------------------
# Node, for repositories that carry front-end assets
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# ---------------------------------------------------------------------------
# Environment managers
# ---------------------------------------------------------------------------
.direnv/
.venv/
__pycache__/
