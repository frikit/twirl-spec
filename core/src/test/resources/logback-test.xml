<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging for the library's own tests, shared with every module through the
  test->test dependency on the core: the library's trace at DEBUG, which the
  coverage gate needs evaluated, and everything else at WARN.
-->
<configuration>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="io.github.frikit.twirlspec" level="DEBUG"/>

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>

</configuration>
